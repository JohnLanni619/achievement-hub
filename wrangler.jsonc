{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "achievement-hub",
	"main": "server/src/index.ts",
	"compatibility_date": "2026-10-01",
	// Serves the built React app; only /api/* runs the Worker. Unknown paths
	// fall back to index.html so client-side routes work on refresh.
	"assets": {
		"directory": "./web/dist",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "achievement-hub",
			"database_id": "91d4937f-2bd4-44f9-aed2-ef63e861b3ba",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"ENABLE_DEMO_PROVIDER": "false"
	},
	"observability": {
		"enabled": true
	}
}