# Port for the API server (the web dev server proxies /api to it)
PORT=3001
# Secret used to encrypt stored provider credentials. REQUIRED in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Where the SQLite database lives
DATABASE_PATH=./data/achievement-hub.db
# Enables a fake "Demo" provider with sample data (defaults to on outside production)
ENABLE_DEMO_PROVIDER=true
